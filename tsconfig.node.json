{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2023"]
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/inject/*.d.ts", "tests/**/*", "electron.vite.config.ts", "vitest.config.mts"]
}
